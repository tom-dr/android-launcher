<?xml version="1.0" encoding="utf-8"?>
<!-- One calendar event in the agenda widget, on a single line: time, then
     title (and location), the title being what gets cut when too long.
     Tap opens it in the calendar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="6dp">

    <!-- Calendar color, as in the calendar app. -->
    <View
        android:id="@+id/agendaEventColor"
        android:layout_width="4dp"
        android:layout_height="18dp"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/agendaEventTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:maxLines="1"
        android:textColor="#99FFFFFF"
        android:textSize="14sp"
        tools:text="08:00 – 09:00" />

    <TextView
        android:id="@+id/agendaEventTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        tools:text="Réunion d'équipe · Bureau" />

</LinearLayout>
